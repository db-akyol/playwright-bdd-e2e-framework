{
  "name": "playwright-bdd-e2e-framework",
  "version": "1.0.0",
  "description": "Playwright + Cucumber (BDD) end-to-end test framework with Page Object Model for the SauceDemo e-commerce site",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:bdd": "bddgen && playwright test --project=bdd-chromium --project=bdd-firefox --project=bdd-webkit",
    "test:spec": "playwright test --project=spec-chromium",
    "test:headed": "bddgen && playwright test --headed --project=bdd-chromium",
    "test:ui": "bddgen && playwright test --ui",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:login": "bddgen && playwright test --grep @giris",
    "test:cart": "bddgen && playwright test --grep @sepet",
    "test:checkout": "bddgen && playwright test --grep @odeme",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.4.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "playwright-bdd": "^8.4.2",
    "typescript": "^5.3.0"
  }
}
