{
  "name": "playwright-pom-ecommerce",
  "version": "1.0.0",
  "description": "Playwright test automation project with POM structure for e-commerce testing",
  "scripts": {
    "bddgen": "bddgen",
    "test": "npx bddgen && npx playwright test",
    "test:headed": "npx bddgen && npx playwright test --headed",
    "test:ui": "npx bddgen && npx playwright test --ui",
    "test:smoke": "npx bddgen && npx playwright test --grep @smoke",
    "test:login": "npx bddgen && npx playwright test --grep @login",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.4.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "playwright-bdd": "^8.4.2",
    "typescript": "^5.3.0"
  }
}
